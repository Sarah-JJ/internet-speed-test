<!DOCTYPE html>
<html class="h-100">
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.css">
    <link rel='stylesheet' href='/stylesheets/style.css'/>
    <link rel='stylesheet' href='/stylesheets/loaders.min.css'/>

    <link href="https://fonts.googleapis.com/css?family=Squada+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Comfortaa&display=swap" rel="stylesheet">

</head>

<body class="h-100">

<div id="parent-container" class="container-fluid d-flex h-100 align-items-center f-24">
    <div id="loaders" class="container text-center">

        <div id="speed-loader" class="d-none"></div>

        <div id="progress-bar" class="d-none">
            <div id="progress-value">
            </div>
        </div>
        <div id="progress-bar-label"></div>

        <!--&lt;!&ndash;        Redo test button&ndash;&gt;-->
        <!--        <button type="button" class="btn" onclick="window.location.reload()" style="border-radius: 50%">-->
        <!--            <img src="https://image.flaticon.com/icons/png/128/122/122666.png"alt="submit" width="35px" height="35px"/>-->
        <!--        </button>-->

        <div id="connecting-loading-indicator-container" class="mb-5">

            <!--        <div id="connecting-gif-row" class="row text-center">-->
            <div class="col-12">
                <img id="connecting-gif" width="400" height="95" src="/images/connecting.gif">
            </div>
            <!--        </div>-->

            <div id="connecting-text" class="row">
                <div class="col">Connecting</div>
            </div>
        </div>
    </div>


</div>

<div id="connection-error" class="row justify-content-center d-none mb-5">

    <div class="card text-white bg-dark mb-3">
        <div class="card-body">
            <h5 class="card-title text-center">Connection Lost</h5>
            <p class="card-text">Something went wrong. Check your internet connection, and try again later.</p>
        </div>
    </div>
</div>

</div>

<div id="internet-speed-elements" class="container-fluid h-50 f-24 text-center position-relative">
    <div class="row justify-content-center">
        <div id="latency" class="speed-element latency col-md-2 col-sm-1"></div>
        <div id="download-speed" class="speed-element download col-md-2 col-sm-1 d-none"></div>
        <div id="upload-speed" class="speed-element upload col-md-2 col-sm-1 d-none"></div>
    </div>

    <!--    <div class="row justify-content-center position-absolute w-100" style="bottom: 30px">-->
    <!--        <div class="col-md-4 col-sm-12 d-inline-block">-->
    <!--            <img src="/images/monitor2.png" width="20px" height="20px" class="mr-1" alt="client icon"> 132.10.24.200-->
    <!--        </div>-->
    <!--        <div class="col-md-4 col-sm-12 d-inline-block">-->
    <!--            <img src="/images/server.png" class="mr-1" width="20px" height="20px" alt="server icon"> Earthlink, Baghdad-->
    <!--        </div>-->
    <!--    </div>-->

</div>


<script src="./javascripts/utils.js"></script>
<script src="./javascripts/progress-bar.js"></script>
<script src="./javascripts/update-dom.js"></script>
<script src="./javascripts/main.js" type="text/javascript"></script>

</body>
</html>
