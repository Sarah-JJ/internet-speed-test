<!DOCTYPE html>
<html class="h-100">
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/bootstrap.css">
    <link rel='stylesheet' href='/stylesheets/style.css'/>
    <link rel='stylesheet' href='/stylesheets/loaders.min.css'/>

    <link href="https://fonts.googleapis.com/css?family=Squada+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Comfortaa&display=swap" rel="stylesheet">

</head>

<body class="h-100">

<div class="container-fluid d-flex h-50 align-items-center f-24">
    <div id="loaders" class="container text-center">

        <div id="speed-loader" class="d-none"></div>

        <div id="progress-bar" class="d-none">
            <div id="progress-value">
            </div>
        </div>
        <div id="progress-bar-label"></div>



        <div id="connecting-loading-indicator-container" class="mb-5">

            <!--        <div id="connecting-gif-row" class="row text-center">-->
            <div class="col-12">
                <img id="connecting-gif" width="400" height="95" src="/images/connecting.gif">
            </div>
            <!--        </div>-->

            <div id="connecting-text" class="row">
                <div class="col">Connecting</div>
            </div>
        </div>
    </div>


</div>

<div id="connection-error" class="row justify-content-center d-none mb-5">

    <div class="card text-white bg-dark mb-3">
        <div class="card-body">
            <h5 class="card-title text-center">Connection Lost</h5>
            <p class="card-text">Something went wrong. Check your internet connection, and try again later.</p>
        </div>
    </div>
</div>

</div>

<div id="internet-speed-elements" class="container-fluid h-50 f-24 text-center">
    <div class="row justify-content-center">
        <div id="latency" class="col-md-4 col-sm-1"></div>
        <div id="downloadSpeed" class="col-md-4 col-sm-1 d-none"></div>
        <div id="uploadSpeed" class="col-md-4 col-sm-1 d-none"></div>

    </div>
</div>


<script src="./javascripts/utils.js"></script>
<script src="./javascripts/progress-bar.js"></script>
<script src="./javascripts/update-dom.js"></script>
<script src="./javascripts/main.js" type="text/javascript"></script>

</body>
</html>
